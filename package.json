{
  "name": "markscope",
  "version": "1.0.0",
  "private": true,
  "description": "A secure, developer-grade Markdown viewer for the browser.",
  "license": "MIT",
  "author": "Abdallah Saeed",
  "homepage": "https://abdallahsaeed.github.io/markscope/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdallahSaeed/markscope.git"
  },
  "bugs": {
    "url": "https://github.com/AbdallahSaeed/markscope/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:vscode": "node scripts/build.mjs --target=vscode",
    "typecheck": "tsc --noEmit",
    "typecheck:vscode": "tsc -p tsconfig.vscode.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:vscode:webview": "playwright test -c playwright.vscode.config.ts",
    "test:vscode": "node scripts/build.mjs --target=vscode && node scripts/build-vscode-tests.mjs && vscode-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "npm run typecheck && npm run typecheck:vscode && npm test && node scripts/build.mjs && node scripts/build.mjs --target=firefox && node scripts/build.mjs --target=vscode && node scripts/package.mjs && node scripts/package-vscode.mjs",
    "package:vscode": "node scripts/package-vscode.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-alert": "^2.0.2",
    "@mdit/plugin-katex-slim": "^1.1.3",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@viz-js/viz": "^3.31.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.2",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  }
}
